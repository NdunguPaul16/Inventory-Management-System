{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev --prefix ..",
  "buildCommand": "npm run build:shared --prefix .. && npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": { "staging/security-audit": false }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://inventory-inc-staging-backend.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
