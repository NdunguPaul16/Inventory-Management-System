{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev --prefix ..",
  "buildCommand": "npm run build:shared --prefix .. && npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": { "phase-2/stock-counts": false }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://inventory-management-backend-jn2c.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
