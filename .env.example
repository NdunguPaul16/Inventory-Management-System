# Copy to `.env` at the repo root. Both the server and the client (Vite) read it.
# Never commit `.env`.

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string. It must be a replica set (Atlas always is) because
# stock postings run in transactions. Leave empty in development to start a
# throwaway in-memory replica set instead (data is lost on restart).
# Atlas M0 example:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=ims

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# --- Client ---
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000
