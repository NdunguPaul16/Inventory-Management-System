# Copy to `.env` at the repo root. Both the backend and the frontend (Vite) read it.
# Never commit `.env`.

# --- Backend ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string. It must be a replica set (Atlas always is) because
# stock postings run in transactions. Leave empty in development to start a
# throwaway in-memory replica set instead (data is lost on restart).
# Atlas M0 example:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=ims

# Authentication keys: use unique random strings with 32+ characters in production.
AUTH_ACCESS_TOKEN_SECRET=development-access-token-secret-change-before-production
AUTH_REFRESH_TOKEN_SECRET=development-refresh-token-secret-change-before-production

# Create the first administrator explicitly with `npm run bootstrap:admin -w backend`.
# No bootstrap credentials belong in this default environment file.

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000
